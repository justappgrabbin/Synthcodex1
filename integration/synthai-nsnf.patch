diff --git a/computer/services/nsnf-field.mjs b/computer/services/nsnf-field.mjs
new file mode 100644
index 0000000..cd28638
--- /dev/null
+++ b/computer/services/nsnf-field.mjs
@@ -0,0 +1,48 @@
+/** Optional real neural-field service. Existing providers and addresses stay intact. */
+export class NSNFFieldService {
+  constructor({ baseUrl, runtime, fetchImpl = globalThis.fetch }) {
+    this.baseUrl = new URL(baseUrl);
+    if (!['127.0.0.1', 'localhost', '[::1]'].includes(this.baseUrl.hostname)) {
+      throw new Error('NSNF field currently supports a local single-owner API only');
+    }
+    this.runtime = runtime;
+    this.fetch = fetchImpl;
+  }
+
+  async request(path, body) {
+    const response = await this.fetch(new URL(path, this.baseUrl), {
+      method: body === undefined ? 'GET' : 'POST',
+      headers: { 'content-type': 'application/json' },
+      ...(body === undefined ? {} : { body: JSON.stringify(body) }),
+      signal: AbortSignal.timeout(30000),
+    });
+    const result = await response.json();
+    if (!response.ok) {
+      this.runtime.bus.emit('service:provider-failure', { provider: 'nsnf-field-v1', status: response.status, result });
+      throw new Error(`NSNF execution failed: ${JSON.stringify(result)}`);
+    }
+    return result;
+  }
+
+  async execute(input) {
+    const result = await this.request('/execute', input);
+    await this.runtime.emitEvent({
+      event_type: 'graph_activation', actor_id: 'nsnf-field', actor_type: 'process',
+      provider: 'nsnf-field-v1', input, result,
+      result_status: 'success', observable_effect: `${result.selected.length} neural components executed`,
+      evidence: { kind: 'neural-run', ref: result.id, summary: 'Real NumPy execution, persisted in private SQLite field store' },
+    });
+    return result;
+  }
+
+  async contact(observation) {
+    const result = await this.request('/events', observation);
+    await this.runtime.emitEvent({
+      event_type: 'observation', actor_id: observation.actor_ref, actor_type: 'user',
+      provider: 'nsnf-field-v1', result, result_status: result.interpretation ? 'success' : 'partial',
+      observable_effect: result.action,
+      evidence: { kind: 'contact-investigation', ref: result.id, summary: result.status },
+    });
+    return result;
+  }
+}
diff --git a/computer/tests/nsnf-integration.test.mjs b/computer/tests/nsnf-integration.test.mjs
new file mode 100644
index 0000000..1bbca9d
--- /dev/null
+++ b/computer/tests/nsnf-integration.test.mjs
@@ -0,0 +1,21 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { mkdtemp, rm } from 'node:fs/promises';
+import { tmpdir } from 'node:os';
+import { join } from 'node:path';
+import { ComputerRuntime } from '../ComputerRuntime.mjs';
+
+test('Computer -> real private NSNF API -> neural trace -> persisted Computer event', {skip: !process.env.NSNF_TEST_URL}, async () => {
+  const dir = await mkdtemp(join(tmpdir(), 'nsnf-computer-'));
+  try {
+    const runtime = await new ComputerRuntime({eventLogPath:join(dir,'events.jsonl'),nsnfBaseUrl:process.env.NSNF_TEST_URL}).boot();
+    const result = await runtime.neuralField.execute({features:[.7,.1,.2,.3,.4,.5,.6,.8],tier:2});
+    assert.equal(result.selected.length,10);
+    assert.equal(result.micro[result.selected[0].component_id].length,2);
+    const events=await runtime.eventEmitter.readAll();
+    assert.ok(events.some(e=>e.provider==='nsnf-field-v1' && e.result.id===result.id));
+    const replay=await runtime.neuralField.request(`/runs/${result.id}/replay`,{});
+    assert.equal(replay.exact,true);
+    assert.ok(runtime.services.has('nsnf-field'));
+  } finally { await rm(dir,{recursive:true,force:true}); }
+});
